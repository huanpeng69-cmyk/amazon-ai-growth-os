# ============================================================
# Amazon AI Growth OS · 配置示例
# 复制本文件为 .env（同目录）并填入真实值即可启用真实接口。
# 所有项均可选；不设则走内置启发式/兜底/mock，系统照常运行。
# ============================================================

# ---------- 1. 文本 AI：Agnes AI（OpenAI 兼容）----------
# 启用后：Visual Agent 视觉策略、Listing/Advertising 中文→英文 改由真实 LLM 生成。
# 文档：https://www.agnes-ai.com/zh-Hans/docs/overview
AGNES_API_KEY=              # 必填（填了才启用真实调用）
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1   # 一般不用改
AGNES_TEXT_MODEL=agnes-gpt-4o                   # 按 Agnes 控制台真实模型 ID 调整
AGNES_IMAGE_MODEL=agnes-sd                      # Agnes 文生图模型 ID（备用）
AGNES_TIMEOUT=60

# ---------- 2. 生图：WisArt 文生图（智画创）----------
# 两步：先把 image_generation 后端切到 api，再填凭据。
# 文档（登录可见）：https://wisart.kuaileshifu.com/#/member/api-docs
TOOL_BACKEND_IMAGE_GENERATION=api     # 默认 mock；设为 api 才走真实生图
WISART_API_KEY=                       # 必填
WISART_BASE_URL=https://wisart.kuaileshifu.com/api   # 默认已填；若 WisArt 基址不同请改
WISART_ENDPOINT=/v1/images/generations             # 文生图路径（按 WisArt 真实契约调整）
WISART_AUTH_SCHEME=Bearer             # Bearer 或 X-API-Key 等自定义头名
WISART_ASYNC=0                        # 若 WisArt 是「提交任务→轮询拿图」异步接口，设为 1

# ---------- 3. 其它工具后端（可选，默认均为 mock）----------
# TOOL_BACKEND_AMAZON_RESEARCH=mcp
# TOOL_BACKEND_VOC_ANALYSIS=mcp
# TOOL_BACKEND_MARKET_SEARCH=mcp
# AMAZON_RESEARCH_MCP_SERVER=bright-data-sorftime-sif-mcp
