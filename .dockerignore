# ── VCS / CI ──
.git
.github
.gitignore

# ── Python 缓存 / 字节码 ──
**/__pycache__
**/*.py[cod]
**/*$py.class
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# ── 虚拟环境 ──
.venv
venv
ENV

# ── 数据库 / 日志（镜像内不带本地库与日志）──
**/*.db
**/*.sqlite
**/*.sqlite3
*.log
server_*.log

# ── 机密（compose 用 env_file 注入，不进镜像）──
.env
.env.local
*.pem
*.key

# ── 测试 / 调试脚本 / 一次性脚本（生产镜像不需要）──
backend/tests
backend/scripts
backend/_debug_*.py
qa_test.py
test_agent.py
test_tools.py

# ── 文档 / 预览图 / 构建产物 ──
*.md
preview.png
dist

# ── 编辑器 / OS ──
.vscode
.idea
.DS_Store
Thumbs.db
